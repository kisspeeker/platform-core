{
	email {{ acme_email }}
	acme_dns cloudflare {env.CF_ACME_TOKEN}
	servers {
		# cloudflared in Docker network `proxy`; matchers use remote_ip, this only affects client_ip/logs
		trusted_proxies static {{ proxy_subnet }}
		client_ip_headers Cf-Connecting-Ip
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
