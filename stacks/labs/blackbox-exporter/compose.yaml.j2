---

services:
  blackbox:
    image: ${BLACKBOX_EXPORTER_IMAGE:-prom/blackbox-exporter:v0.28.0}
    pull_policy: ${PULL_POLICY:-missing}
    container_name: lab-blackbox-exporter
    restart: unless-stopped
    user: "65534:65534"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    command:
      - --config.file=/etc/blackbox_exporter/blackbox.yml
    volumes:
      - /opt/platform/stacks/blackbox-exporter/blackbox.yml:/etc/blackbox_exporter/blackbox.yml:ro
    ports:
      - "9115:9115"
    networks:
      - metrics

networks:
  metrics:
    external: true
    name: metrics
