# Docs: https://thekelleys.org.uk/dnsmasq/docs/dnsmasq-man.html

listen-address={{ mesh_ip }}
bind-dynamic
no-hosts
no-resolv
server=1.1.1.1
server=9.9.9.9
domain-needed
bogus-priv
{% for zone in zones %}
local=/{{ zone }}/
{% endfor %}
{% for fqdn, ip in records %}
host-record={{ fqdn }},{{ ip }}
{% endfor %}
